  "actions": [
    {
      "id": "transcribe",
      "label": "Transcribe",
      "runLabel": "Transcribe",
      "description": "Pick any audio or video file. The first run downloads the speech model once (about 200 MB); after that everything works offline.",
      "mcpDescription": "Transcribe an audio or video file on the user's computer (mp3, m4a, wav, mp4, mov, …) to text with Whisper, offline. Returns the full transcript (optionally with [hh:mm:ss] timestamps) and can also save it to a .txt file (`out`). Set `translate` to get an English translation instead. Use this whenever the user wants a recording, voice memo, meeting or video turned into text, notes or a summary.",
      "fields": [
        {
          "id": "input",
          "label": "Recording or video",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "Audio & video",
              "extensions": [
                "mp3",
                "m4a",
                "wav",
                "aac",
                "ogg",
                "opus",
                "flac",
                "wma",
                "mp4",
                "mov",
                "mkv",
                "webm",
                "avi",
                "m4v",
                "3gp",
                "amr"
              ]
            }
          ]
        },
        {
          "id": "language",
          "label": "Spoken language",
          "type": "select",
          "default": "",
          "options": [
            {
              "value": "",
              "label": "Detect automatically"
            },
            {
              "value": "en",
              "label": "English"
            },
            {
              "value": "es",
              "label": "Spanish"
            },
            {
              "value": "fr",
              "label": "French"
            },
            {
              "value": "de",
              "label": "German"
            },
            {
              "value": "it",
              "label": "Italian"
            },
            {
              "value": "pt",
              "label": "Portuguese"
            },
            {
              "value": "nl",
              "label": "Dutch"
            },
            {
              "value": "ru",
              "label": "Russian"
            },
            {
              "value": "uk",
              "label": "Ukrainian"
            },
            {
              "value": "pl",
              "label": "Polish"
            },
            {
              "value": "tr",
              "label": "Turkish"
            },
            {
              "value": "ar",
              "label": "Arabic"
            },
            {
              "value": "he",
              "label": "Hebrew"
            },
            {
              "value": "hi",
              "label": "Hindi"
            },
            {
              "value": "zh",
              "label": "Chinese"
            },
            {
              "value": "ja",
              "label": "Japanese"
            },
            {
              "value": "ko",
              "label": "Korean"
            }
          ]
        },
        {
          "id": "translate",
          "label": "Translate to English",
          "type": "checkbox"
        },
        {
          "id": "timestamps",
          "label": "Add timestamps",
          "type": "checkbox",
          "default": true
        },
        {
          "id": "out",
          "label": "Save transcript as (optional)",
          "type": "savefile",
          "filters": [
            {
              "name": "Text",
              "extensions": [
                "txt"
              ]
            }
          ]
        }
      ],
      "prepare": {
        "tool": "ffmpeg",
        "argv": [
          "-y",
          "-i",
          "{input}",
          "-vn",
          "-ac",
          "1",
          "-ar",
          "16000",
          "-af",
          "apad=pad_dur=1",
          "-c:a",
          "pcm_s16le",
          "{tmp}"
        ],
        "replaces": "input",
        "ext": ".wav"
      },
      "cwd": "tool",
      "saveStdout": {
        "field": "out",
        "transform": "segments",
        "stampsField": "timestamps"
      },
      "maxOutput": 80000,
      "argv": [
        "--silero-vad-model=extras/vad/silero_vad.onnx",
        "--whisper-encoder=extras/model/sherpa-onnx-whisper-base/base-encoder.int8.onnx",
        "--whisper-decoder=extras/model/sherpa-onnx-whisper-base/base-decoder.int8.onnx",
        "--tokens=extras/model/sherpa-onnx-whisper-base/base-tokens.txt",
        "--num-threads=4",
        {
          "field": "language",
          "flag": "--whisper-language",
          "join": "="
        },
        {
          "when": "translate",
          "argv": [
            "--whisper-task=translate"
          ]
        },
        {
          "field": "input"
        }
      ],
      "openAfter": "out",
      "successMessage": "Transcribed.",
      "helpArgs": [
        [
          "--help"
        ]
      ]
    },
    {
