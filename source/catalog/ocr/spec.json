  "actions": [
    {
      "id": "pdf",
      "label": "Make a scanned PDF searchable",
      "runLabel": "Make searchable",
      "description": "Pick a scanned PDF (from a scanner or a phone scanning app). Every page is read with OCR and you get a new PDF that looks the same but whose text you can search, select and copy, plus all the text in a .txt file. Runs on your computer; nothing is uploaded. The first run downloads the OCR engine once (about 60–130 MB).",
      "mcpDescription": "Make a scanned (image-only) PDF searchable on the user's computer, offline: OCR every page (Tesseract via Rescribe) and save `<name> searchable.pdf` (same look, selectable/searchable text layer) plus `<name>.txt` (all the text) into `outDir`. Use for 'make this scan searchable', 'what does this scanned contract/invoice/letter say', 'extract text from my scanned PDFs', especially for long or private documents that should not be uploaded. Set `lang` to the document's language. Then read the .txt to answer questions about the document. Works with PDFs whose pages are JPEG/PNG/TIFF images (scanners, phone scan apps); if it reports an unsupported image type, export the pages as images and use ocr_folder.",
      "fields": [
        {
          "id": "input",
          "label": "Scanned PDF",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "PDF",
              "extensions": [
                "pdf"
              ]
            }
          ]
        },
        {
          "id": "lang",
          "label": "Language of the text",
          "type": "select",
          "default": "eng",
          "options": [
            {
              "value": "eng",
              "label": "English"
            },
            {
              "value": "deu",
              "label": "German"
            },
            {
              "value": "fra",
              "label": "French"
            },
            {
              "value": "spa",
              "label": "Spanish"
            },
            {
              "value": "ita",
              "label": "Italian"
            },
            {
              "value": "por",
              "label": "Portuguese"
            },
            {
              "value": "nld",
              "label": "Dutch"
            },
            {
              "value": "pol",
              "label": "Polish"
            }
          ]
        },
        {
          "id": "outDir",
          "label": "Save into folder",
          "type": "folder",
          "required": true
        }
      ],
      "argv": [
        "-t",
        {
          "fmt": "{_selfDir}/extras/{lang}/{lang}.traineddata"
        },
        {
          "field": "input"
        },
        {
          "field": "outDir"
        }
      ],
      "openAfter": "outDir",
      "successMessage": "Searchable PDF and text saved in the folder.",
      "helpArgs": [
        [
          "-h"
        ]
      ]
    },
    {
      "id": "folder",
      "label": "Turn photos of pages into a searchable PDF",
      "runLabel": "Make PDF",
      "description": "Pick a folder of page photos or scans (JPG, PNG or TIFF, in page order by file name). You get one searchable PDF of all pages plus a .txt with all the text. Runs on your computer; nothing is uploaded.",
      "mcpDescription": "Turn a folder of page images (JPG/PNG/TIFF photos or scans, ordered by file name) into one searchable PDF plus a .txt of all the text, offline on the user's computer (Tesseract OCR via Rescribe). Output goes into `outDir` (`<folder name> searchable.pdf` and `<folder name>.txt`). Use for 'turn these photos of a document into a PDF', 'OCR these scanned pages', 'extract the text from these images'. Set `lang` to the text's language.",
      "fields": [
        {
          "id": "pages",
          "label": "Folder of page images",
          "type": "folder",
          "required": true
        },
        {
          "id": "lang",
          "label": "Language of the text",
          "type": "select",
          "default": "eng",
          "options": [
            {
              "value": "eng",
              "label": "English"
            },
            {
              "value": "deu",
              "label": "German"
            },
            {
              "value": "fra",
              "label": "French"
            },
            {
              "value": "spa",
              "label": "Spanish"
            },
            {
              "value": "ita",
              "label": "Italian"
            },
            {
              "value": "por",
              "label": "Portuguese"
            },
            {
              "value": "nld",
              "label": "Dutch"
            },
            {
              "value": "pol",
              "label": "Polish"
            }
          ]
        },
        {
          "id": "outDir",
          "label": "Save into folder",
          "type": "folder",
          "required": true
        }
      ],
      "argv": [
        "-t",
        {
          "fmt": "{_selfDir}/extras/{lang}/{lang}.traineddata"
        },
        {
          "field": "pages"
        },
        {
          "field": "outDir"
        }
      ],
      "openAfter": "outDir",
      "successMessage": "Searchable PDF and text saved in the folder.",
      "helpArgs": [
        [
          "-h"
        ]
      ]
    }
  ]
