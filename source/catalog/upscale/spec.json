  "actions": [
    {
      "id": "upscale",
      "label": "Upscale an image",
      "runLabel": "Upscale",
      "description": "Pick a JPG, PNG or WebP. The picture is enlarged 4× and AI fills in sharp detail. Uses your graphics card (most computers from the last ~8 years); large images can take a minute.",
      "mcpDescription": "Upscale/enhance an image on the user's computer 4× with Real-ESRGAN AI (offline): makes small, blurry or low-resolution photos and pictures larger and sharper, e.g. for printing, wallpapers or old photos. Input JPG/PNG/WebP; saves a new image (format from the output file extension). Choose `model` 'anime' for drawings, cartoons and anime art, otherwise 'photo'. Needs a GPU with Vulkan support (most computers from the last ~8 years).",
      "fields": [
        {
          "id": "input",
          "label": "Image",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "Images",
              "extensions": [
                "jpg",
                "jpeg",
                "png",
                "webp"
              ]
            }
          ]
        },
        {
          "id": "model",
          "label": "Picture type",
          "type": "select",
          "default": "realesrgan-x4plus",
          "options": [
            {
              "value": "realesrgan-x4plus",
              "label": "Photo"
            },
            {
              "value": "realesrgan-x4plus-anime",
              "label": "Drawing / anime / cartoon"
            }
          ]
        },
        {
          "id": "out",
          "label": "Save upscaled image as",
          "type": "savefile",
          "required": true,
          "filters": [
            {
              "name": "Images",
              "extensions": [
                "png",
                "jpg",
                "webp"
              ]
            }
          ]
        }
      ],
      "cwd": "tool",
      "argv": [
        {
          "field": "input",
          "flag": "-i"
        },
        {
          "field": "out",
          "flag": "-o"
        },
        {
          "field": "model",
          "flag": "-n"
        },
        "-s",
        "4",
        "-m",
        "models"
      ],
      "openAfter": "out",
      "successMessage": "Upscaled 4×.",
      "helpArgs": [
        [
          "-h"
        ]
      ]
    }
  ]
