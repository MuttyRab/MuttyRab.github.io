{
  "id": "clips",
  "product": "audio",
  "name": "Short Clips Maker",
  "tagline": "Turn the best moments of a long video into vertical clips with captions for TikTok, Reels and Shorts — on your own computer.",
  "keywords": [
    "long video to short clips",
    "make shorts from youtube video",
    "podcast to tiktok clips",
    "vertical video with captions",
    "add captions to clip automatically",
    "opus clip alternative",
    "video clips mcp",
    "audiogram maker",
    "podcast to video",
    "audio to video with waveform"
  ],
  "tier": "pro",
  "status": "live",
  "upstream": {
    "repo": "FFmpeg/FFmpeg",
    "stars": 50000,
    "displayName": "FFmpeg + Whisper",
    "license": "GPL (FFmpeg static build), MIT (Whisper model), Inter font: OFL-1.1",
    "homepage": "https://ffmpeg.org"
  },
  "binary": {
    "name": "ffmpeg",
    "version": "6.1.1",
    "assets": {
      "linux-x64": {
        "url": "https://github.com/eugeneware/ffmpeg-static/releases/download/b6.1.1/ffmpeg-linux-x64",
        "path": "ffmpeg",
        "sha256": "e7e7fb30477f717e6f55f9180a70386c62677ef8a4d4d1a5d948f4098aa3eb99"
      },
      "darwin-arm64": {
        "url": "https://github.com/eugeneware/ffmpeg-static/releases/download/b6.1.1/ffmpeg-darwin-arm64",
        "path": "ffmpeg",
        "sha256": "a90e3db6a3fd35f6074b013f948b1aa45b31c6375489d39e572bea3f18336584"
      },
      "darwin-x64": {
        "url": "https://github.com/eugeneware/ffmpeg-static/releases/download/b6.1.1/ffmpeg-darwin-x64",
        "path": "ffmpeg",
        "sha256": "ebdddc936f61e14049a2d4b549a412b8a40deeff6540e58a9f2a2da9e6b18894"
      },
      "win32-x64": {
        "url": "https://github.com/eugeneware/ffmpeg-static/releases/download/b6.1.1/ffmpeg-win32-x64",
        "path": "ffmpeg.exe",
        "sha256": "04e1307997530f9cf2fe35cba2ca7e8875ca91da02f89d6c7243df819c94ad00"
      }
    },
    "extras": [
      {
        "name": "font",
        "url": "https://github.com/rsms/inter/releases/download/v4.1/Inter-4.1.zip",
        "sha256": "9883fdd4a49d4fb66bd8177ba6625ef9a64aa45899767dde3d36aa425756b11e"
      }
    ]
  },
  "actions": [
    {
      "id": "make",
      "label": "Make a short clip",
      "runLabel": "Make clip",
      "description": "Pick a video and the part you want (from – to). You get an MP4 cut to that part, cropped to vertical 9:16 (or square), with captions timed to the speech burned in. Ask your AI to find the best moments for you: it can read the transcript and make one clip per moment. Works offline — everything it needs is included in the app.",
      "mcpDescription": "Make a short social-media clip (MP4) from a longer video on the user's computer, offline: the part from `start` to `end` is cut out, cropped to vertical 9:16 for TikTok/Reels/Shorts (or square / original shape) and captions timed to the speech (Whisper) are burned in. Use when the user wants shorts, reels, TikToks, highlights or clips from a podcast, interview, stream, lecture or webinar. To find good moments first, get the timestamped transcript (watch_video or transcribe_transcribe), pick self-contained 20–60 s passages with a strong opening line, then call this once per clip with a clear file name for each.",
      "fields": [
        {
          "id": "input",
          "label": "Long video",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "Video",
              "extensions": [
                "mp4",
                "mov",
                "mkv",
                "webm",
                "avi",
                "m4v",
                "3gp"
              ]
            }
          ]
        },
        {
          "id": "start",
          "label": "From",
          "type": "text",
          "required": true,
          "default": "0:00",
          "placeholder": "12:30 or 750"
        },
        {
          "id": "end",
          "label": "To",
          "type": "text",
          "required": true,
          "placeholder": "13:15 or 795"
        },
        {
          "id": "shape",
          "label": "Shape",
          "type": "select",
          "default": "crop='min(iw,ih*9/16)':'min(ih,iw*16/9)',scale=1080:1920",
          "options": [
            {
              "value": "crop='min(iw,ih*9/16)':'min(ih,iw*16/9)',scale=1080:1920",
              "label": "Vertical 9:16 (TikTok, Reels, Shorts) — middle of the picture"
            },
            {
              "value": "crop='min(iw,ih)':'min(iw,ih)',scale=1080:1080",
              "label": "Square 1:1 (feeds)"
            },
            {
              "value": "scale=-2:'min(1080,ih)'",
              "label": "Keep the original shape"
            }
          ]
        },
        {
          "id": "language",
          "label": "Spoken language",
          "type": "select",
          "default": "",
          "options": [
            {
              "value": "",
              "label": "Detect automatically"
            },
            {
              "value": "en",
              "label": "English"
            },
            {
              "value": "es",
              "label": "Spanish"
            },
            {
              "value": "fr",
              "label": "French"
            },
            {
              "value": "de",
              "label": "German"
            },
            {
              "value": "it",
              "label": "Italian"
            },
            {
              "value": "pt",
              "label": "Portuguese"
            },
            {
              "value": "nl",
              "label": "Dutch"
            },
            {
              "value": "ru",
              "label": "Russian"
            },
            {
              "value": "uk",
              "label": "Ukrainian"
            },
            {
              "value": "pl",
              "label": "Polish"
            },
            {
              "value": "tr",
              "label": "Turkish"
            },
            {
              "value": "ar",
              "label": "Arabic"
            },
            {
              "value": "he",
              "label": "Hebrew"
            },
            {
              "value": "hi",
              "label": "Hindi"
            },
            {
              "value": "zh",
              "label": "Chinese"
            },
            {
              "value": "ja",
              "label": "Japanese"
            },
            {
              "value": "ko",
              "label": "Korean"
            }
          ]
        },
        {
          "id": "out",
          "label": "Save clip as",
          "type": "savefile",
          "required": true,
          "filters": [
            {
              "name": "MP4 video",
              "extensions": [
                "mp4"
              ]
            }
          ]
        }
      ],
      "prepare": [
        {
          "tool": "ffmpeg",
          "argv": [
            "-y",
            "-ss",
            "{start}",
            "-to",
            "{end}",
            "-i",
            "{input}",
            "-map",
            "0:v:0",
            "-map",
            "0:a:0?",
            "-vcodec",
            "libx264",
            "-preset",
            "veryfast",
            "-crf",
            "18",
            "-pix_fmt",
            "yuv420p",
            "-acodec",
            "aac",
            "-ab",
            "192k",
            "-f",
            "matroska",
            "{tmp:clip.mkv}"
          ],
          "sets": {
            "_clip": "clip.mkv"
          }
        },
        {
          "tool": "ffmpeg",
          "optional": true,
          "argv": [
            "-y",
            "-i",
            "{_clip}",
            "-vn",
            "-ac",
            "1",
            "-ar",
            "16000",
            "-af",
            "apad=pad_dur=1",
            "-c:a",
            "pcm_s16le",
            "{tmp:a16.wav}"
          ],
          "sets": {
            "_a16": "a16.wav"
          }
        },
        {
          "tool": "transcribe",
          "cwd": "tool",
          "requires": "_a16",
          "argv": [
            "--silero-vad-model=extras/vad/silero_vad.onnx",
            "--whisper-encoder=extras/model/sherpa-onnx-whisper-base/base-encoder.int8.onnx",
            "--whisper-decoder=extras/model/sherpa-onnx-whisper-base/base-decoder.int8.onnx",
            "--tokens=extras/model/sherpa-onnx-whisper-base/base-tokens.txt",
            "--num-threads=4",
            "--whisper-language={language}",
            "{_a16}"
          ],
          "captureStdout": "_cap"
        },
        {
          "write": "captions.srt",
          "from": "_cap",
          "transform": "srt",
          "sets": "_srt",
          "emptyText": "1\n00:00:00,000 --> 00:00:00,040\n ",
          "maxChars": 22
        }
      ],
      "cwd": "tool",
      "argv": [
        "-y",
        "-i",
        {
          "fmt": "{_clip}"
        },
        "-vf",
        {
          "fmt": "{shape},subtitles={_srt|filter}:fontsdir=extras/font/extras/ttf:force_style='FontName=Inter,Bold=1,FontSize=15,PrimaryColour=&H00FFFFFF,OutlineColour=&H00000000,BorderStyle=1,Outline=2,Shadow=0,Alignment=2,MarginV=80'"
        },
        "-vcodec",
        "libx264",
        "-preset",
        "veryfast",
        "-crf",
        "20",
        "-pix_fmt",
        "yuv420p",
        "-acodec",
        "copy",
        "-movflags",
        "+faststart",
        {
          "field": "out"
        }
      ],
      "openAfter": "out",
      "successMessage": "Clip ready.",
      "helpArgs": [
        [
          "-h",
          "full"
        ]
      ]
    },
    {
      "id": "burn",
      "label": "Burn captions into a video",
      "runLabel": "Burn captions",
      "description": "Pick a video and a subtitle file (.srt) — for example one translated into another language — and get a copy of the video with the captions drawn into the picture, so they show everywhere (Instagram, TikTok, WhatsApp, LinkedIn) without a separate subtitle file.",
      "mcpDescription": "Burn (hard-code) subtitles from an .srt file into a video on the user's computer, offline (FFmpeg + libass, Inter font): the captions become part of the picture, so they show on Instagram, TikTok, WhatsApp, LinkedIn and in any player. Use when the user wants captions/subtitles 'in the video', 'always visible' or translated into another language: make the .srt with transcribe_subtitles, translate or correct it yourself if asked (keep the numbering and timestamps exactly), save it, then call this. `style`: 'bottom' (classic), 'big' (large, higher up — vertical/short videos), 'box' (white on a dark box — busy backgrounds).",
      "fields": [
        {
          "id": "input",
          "label": "Video",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "Video",
              "extensions": [
                "mp4",
                "mov",
                "mkv",
                "webm",
                "avi",
                "m4v",
                "3gp"
              ]
            }
          ]
        },
        {
          "id": "subs",
          "label": "Subtitles (.srt)",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "Subtitles",
              "extensions": [
                "srt"
              ]
            }
          ]
        },
        {
          "id": "style",
          "label": "Caption style",
          "type": "select",
          "default": "FontName=Inter,Bold=1,FontSize=13,PrimaryColour=&H00FFFFFF,OutlineColour=&H00000000,Outline=1.5,Shadow=0,Alignment=2,MarginV=20",
          "options": [
            {
              "value": "FontName=Inter,Bold=1,FontSize=13,PrimaryColour=&H00FFFFFF,OutlineColour=&H00000000,Outline=1.5,Shadow=0,Alignment=2,MarginV=20",
              "label": "Classic — white, bottom"
            },
            {
              "value": "FontName=Inter,Bold=1,FontSize=15,PrimaryColour=&H00FFFFFF,OutlineColour=&H00000000,Outline=2,Shadow=0,Alignment=2,MarginV=80",
              "label": "Big — for vertical / short videos"
            },
            {
              "value": "FontName=Inter,Bold=1,FontSize=13,PrimaryColour=&H00FFFFFF,BackColour=&H99000000,BorderStyle=3,Outline=6,Shadow=0,Alignment=2,MarginV=20",
              "label": "White on a dark box — for busy backgrounds"
            }
          ]
        },
        {
          "id": "out",
          "label": "Save video as",
          "type": "savefile",
          "required": true,
          "filters": [
            {
              "name": "MP4 video",
              "extensions": [
                "mp4"
              ]
            }
          ]
        }
      ],
      "cwd": "tool",
      "argv": [
        "-y",
        "-i",
        {
          "field": "input"
        },
        "-vf",
        {
          "fmt": "subtitles={_subs|filter}:charenc=UTF-8:fontsdir=extras/font/extras/ttf:force_style='{style}'"
        },
        "-vcodec",
        "libx264",
        "-preset",
        "veryfast",
        "-crf",
        "20",
        "-pix_fmt",
        "yuv420p",
        "-acodec",
        "copy",
        "-movflags",
        "+faststart",
        {
          "field": "out"
        }
      ],
      "openAfter": "out",
      "successMessage": "Video with captions ready.",
      "helpArgs": [
        [
          "-h",
          "full"
        ]
      ],
      "prepare": [
        {
          "tool": "ffmpeg",
          "argv": [
            "-y",
            "-i",
            "{subs}",
            "{tmp:subs.srt}"
          ],
          "sets": {
            "_subs": "subs.srt"
          }
        }
      ]
    },
    {
      "id": "audiogram",
      "label": "Make an audiogram (audio → video)",
      "runLabel": "Make audiogram",
      "description": "Turn a podcast or voice clip into a shareable video: your cover art, a moving waveform and captions timed to the speech. Pick the audio, the part (from – to) and the cover image. Ask your AI to find the best moment from the transcript.",
      "mcpDescription": "Make an audiogram (MP4) on the user's computer, offline: the part of an audio file (podcast, interview, voice note) from `start` to `end` becomes a video with the `cover` image, an animated waveform and burned-in captions timed to the speech (Whisper). Use when the user wants to share audio on Instagram, TikTok, YouTube Shorts, LinkedIn or X, which need video. To pick a moment, get the transcript first (transcribe_transcribe), choose a self-contained 20–60 s passage, then call this; one call per clip. `shape`: vertical (Reels/TikTok/Shorts), square (feeds) or landscape (YouTube/X).",
      "fields": [
        {
          "id": "input",
          "label": "Audio (podcast, interview, voice note)",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "Audio & video",
              "extensions": [
                "mp3",
                "m4a",
                "wav",
                "aac",
                "ogg",
                "opus",
                "flac",
                "mp4",
                "mov",
                "mkv",
                "webm"
              ]
            }
          ]
        },
        {
          "id": "cover",
          "label": "Cover image",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "Images",
              "extensions": [
                "jpg",
                "jpeg",
                "png",
                "webp"
              ]
            }
          ]
        },
        {
          "id": "start",
          "label": "From",
          "type": "text",
          "required": true,
          "default": "0:00",
          "placeholder": "12:30 or 750"
        },
        {
          "id": "end",
          "label": "To",
          "type": "text",
          "required": true,
          "placeholder": "13:15 or 795"
        },
        {
          "id": "shape",
          "label": "Shape",
          "type": "select",
          "default": "[0:v]split[c0][c1];[c0]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,boxblur=30:2,eq=brightness=-0.3[bg];[c1]scale=860:860:force_original_aspect_ratio=decrease[cv];[1:a]aformat=channel_layouts=mono,volume=3,showwaves=s=1080x240:mode=cline:scale=sqrt:draw=full:rate=30:colors=white,format=rgba[w];[bg][cv]overlay=(W-w)/2:240[b1];[b1]drawbox=x=0:y=1160:w=1080:h=240:color=black@0.45:t=fill[b2];[b2][w]overlay=0:1160,format=yuv420p[v0]",
          "options": [
            {
              "value": "[0:v]split[c0][c1];[c0]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920,boxblur=30:2,eq=brightness=-0.3[bg];[c1]scale=860:860:force_original_aspect_ratio=decrease[cv];[1:a]aformat=channel_layouts=mono,volume=3,showwaves=s=1080x240:mode=cline:scale=sqrt:draw=full:rate=30:colors=white,format=rgba[w];[bg][cv]overlay=(W-w)/2:240[b1];[b1]drawbox=x=0:y=1160:w=1080:h=240:color=black@0.45:t=fill[b2];[b2][w]overlay=0:1160,format=yuv420p[v0]",
              "label": "Vertical 9:16 (Reels, TikTok, Shorts)"
            },
            {
              "value": "[0:v]split[c0][c1];[c0]scale=1080:1080:force_original_aspect_ratio=increase,crop=1080:1080,boxblur=30:2,eq=brightness=-0.3[bg];[c1]scale=560:560:force_original_aspect_ratio=decrease[cv];[1:a]aformat=channel_layouts=mono,volume=3,showwaves=s=1080x180:mode=cline:scale=sqrt:draw=full:rate=30:colors=white,format=rgba[w];[bg][cv]overlay=(W-w)/2:50[b1];[b1]drawbox=x=0:y=640:w=1080:h=180:color=black@0.45:t=fill[b2];[b2][w]overlay=0:640,format=yuv420p[v0]",
              "label": "Square 1:1 (Instagram, LinkedIn feeds)"
            },
            {
              "value": "[0:v]split[c0][c1];[c0]scale=1920:1080:force_original_aspect_ratio=increase,crop=1920:1080,boxblur=30:2,eq=brightness=-0.3[bg];[c1]scale=640:640:force_original_aspect_ratio=decrease[cv];[1:a]aformat=channel_layouts=mono,volume=3,showwaves=s=1000x260:mode=cline:scale=sqrt:draw=full:rate=30:colors=white,format=rgba[w];[bg][cv]overlay=120:220[b1];[b1]drawbox=x=860:y=300:w=1000:h=260:color=black@0.45:t=fill[b2];[b2][w]overlay=860:300,format=yuv420p[v0]",
              "label": "Landscape 16:9 (YouTube, X)"
            }
          ]
        },
        {
          "id": "language",
          "label": "Spoken language",
          "type": "select",
          "default": "",
          "options": [
            {
              "value": "",
              "label": "Detect automatically"
            },
            {
              "value": "en",
              "label": "English"
            },
            {
              "value": "es",
              "label": "Spanish"
            },
            {
              "value": "fr",
              "label": "French"
            },
            {
              "value": "de",
              "label": "German"
            },
            {
              "value": "it",
              "label": "Italian"
            },
            {
              "value": "pt",
              "label": "Portuguese"
            },
            {
              "value": "nl",
              "label": "Dutch"
            },
            {
              "value": "ru",
              "label": "Russian"
            },
            {
              "value": "uk",
              "label": "Ukrainian"
            },
            {
              "value": "pl",
              "label": "Polish"
            },
            {
              "value": "tr",
              "label": "Turkish"
            },
            {
              "value": "ar",
              "label": "Arabic"
            },
            {
              "value": "he",
              "label": "Hebrew"
            },
            {
              "value": "hi",
              "label": "Hindi"
            },
            {
              "value": "zh",
              "label": "Chinese"
            },
            {
              "value": "ja",
              "label": "Japanese"
            },
            {
              "value": "ko",
              "label": "Korean"
            }
          ]
        },
        {
          "id": "out",
          "label": "Save video as",
          "type": "savefile",
          "required": true,
          "filters": [
            {
              "name": "MP4 video",
              "extensions": [
                "mp4"
              ]
            }
          ]
        }
      ],
      "prepare": [
        {
          "tool": "ffmpeg",
          "argv": [
            "-y",
            "-ss",
            "{start}",
            "-to",
            "{end}",
            "-i",
            "{input}",
            "-vn",
            "-ac",
            "2",
            "-ar",
            "48000",
            "-c:a",
            "pcm_s16le",
            "{tmp:cut.wav}"
          ],
          "sets": {
            "_cut": "cut.wav"
          }
        },
        {
          "tool": "ffmpeg",
          "argv": [
            "-y",
            "-i",
            "{_cut}",
            "-ac",
            "1",
            "-ar",
            "16000",
            "-af",
            "apad=pad_dur=1",
            "-c:a",
            "pcm_s16le",
            "{tmp:a16.wav}"
          ],
          "sets": {
            "_a16": "a16.wav"
          }
        },
        {
          "tool": "transcribe",
          "cwd": "tool",
          "argv": [
            "--silero-vad-model=extras/vad/silero_vad.onnx",
            "--whisper-encoder=extras/model/sherpa-onnx-whisper-base/base-encoder.int8.onnx",
            "--whisper-decoder=extras/model/sherpa-onnx-whisper-base/base-decoder.int8.onnx",
            "--tokens=extras/model/sherpa-onnx-whisper-base/base-tokens.txt",
            "--num-threads=4",
            "--whisper-language={language}",
            "{_a16}"
          ],
          "captureStdout": "_cap"
        },
        {
          "write": "captions.srt",
          "from": "_cap",
          "transform": "srt",
          "maxChars": 24,
          "sets": "_srt",
          "emptyText": "1\n00:00:00,000 --> 00:00:00,040\n "
        }
      ],
      "cwd": "tool",
      "argv": [
        "-y",
        "-loop",
        "1",
        "-framerate",
        "30",
        "-i",
        {
          "field": "cover"
        },
        "-i",
        {
          "fmt": "{_cut}"
        },
        "-filter_complex",
        {
          "fmt": "{shape};[v0]subtitles={_srt|filter}:fontsdir=extras/font/extras/ttf:force_style='FontName=Inter,Bold=1,FontSize=14,PrimaryColour=&H00FFFFFF,OutlineColour=&H00000000,Outline=2,Shadow=0,Alignment=2,MarginV=36'[v]"
        },
        "-map",
        "[v]",
        "-map",
        "1:a",
        "-shortest",
        "-r",
        "30",
        "-vcodec",
        "libx264",
        "-preset",
        "veryfast",
        "-crf",
        "20",
        "-pix_fmt",
        "yuv420p",
        "-acodec",
        "aac",
        "-ab",
        "192k",
        "-movflags",
        "+faststart",
        {
          "field": "out"
        }
      ],
      "openAfter": "out",
      "successMessage": "Audiogram ready.",
      "helpArgs": [
        [
          "-h",
          "full"
        ]
      ]
    }
