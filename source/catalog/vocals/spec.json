    "extras": [
      {
        "name": "model",
        "url": "https://github.com/k2-fsa/sherpa-onnx/releases/download/source-separation-models/UVR-MDX-NET-Inst_HQ_3.onnx",
        "sha256": "c207b845d51dc1303c543503f6f5a8b596da5d7de97bead77b3e16ec38e8d5b3"
      }
    ],
    "bundlePrune": true
  },
  "actions": [
    {
      "id": "split",
      "label": "Remove vocals",
      "runLabel": "Split the song",
      "description": "Pick a song or video. You get two files: the music without vocals (instrumental / karaoke) and the vocals on their own. The first run downloads the model once (about 67 MB).",
      "mcpDescription": "Separate a song (any audio or video file on the user's computer) into an instrumental/karaoke track with the vocals removed and a vocals-only (acapella) track, offline with the UVR MDX-Net model. Saves two .wav files. Use whenever the user wants to remove vocals, make karaoke or a backing track, get an instrumental, or isolate/extract vocals or an acapella from a song. Takes roughly the song's length to run.",
      "fields": [
        {
          "id": "input",
          "label": "Song or video",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "Audio & video",
              "extensions": [
                "mp3",
                "m4a",
                "wav",
                "aac",
                "ogg",
                "opus",
                "flac",
                "wma",
                "mp4",
                "mov",
                "mkv",
                "webm",
                "avi",
                "m4v"
              ]
            }
          ]
        },
        {
          "id": "instrumental",
          "label": "Save instrumental (no vocals) as",
          "type": "savefile",
          "required": true,
          "filters": [
            {
              "name": "WAV audio",
              "extensions": [
                "wav"
              ]
            }
          ]
        },
        {
          "id": "vocals",
          "label": "Save vocals only as",
          "type": "savefile",
          "required": true,
          "filters": [
            {
              "name": "WAV audio",
              "extensions": [
                "wav"
              ]
            }
          ]
        }
      ],
      "prepare": {
        "tool": "ffmpeg",
        "argv": [
          "-y",
          "-i",
          "{input}",
          "-vn",
          "-ac",
          "2",
          "-ar",
          "44100",
          "-c:a",
          "pcm_s16le",
          "{tmp}"
        ],
        "replaces": "input",
        "ext": ".wav"
      },
      "cwd": "tool",
      "argv": [
        "--uvr-model=extras/model/UVR-MDX-NET-Inst_HQ_3.onnx",
        "--num-threads=4",
        {
          "field": "input",
          "flag": "--input-wav",
          "join": "="
        },
        {
          "field": "instrumental",
          "flag": "--output-vocals-wav",
          "join": "="
        },
        {
          "field": "vocals",
          "flag": "--output-accompaniment-wav",
          "join": "="
        }
      ],
      "openAfter": "instrumental",
      "successMessage": "Done — instrumental and vocals saved.",
      "helpArgs": [
        [
          "--help"
        ]
      ]
    }
  ]
}
