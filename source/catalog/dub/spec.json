{
  "id": "dub",
  "product": "audio",
  "name": "Video Dubbing & Voice-over",
  "tagline": "Give a video a natural voice-over in Spanish, French, German, Japanese and 27 more languages — from translated subtitles, timed to the original, on your own computer.",
  "keywords": [
    "dub video into spanish",
    "ai dubbing offline",
    "translate video voice over",
    "video voice over another language",
    "ai voice over translation",
    "elevenlabs dubbing alternative",
    "video dubbing mcp",
    "multilingual text to speech"
  ],
  "tier": "pro",
  "status": "live",
  "upstream": {
    "repo": "supertone-inc/supertonic",
    "stars": 3000,
    "displayName": "Supertonic voices (sherpa-onnx) + FFmpeg",
    "license": "MIT (Supertonic 3 model), Apache-2.0 (sherpa-onnx), GPL (FFmpeg static build)",
