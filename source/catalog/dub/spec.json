              "value": "0.15",
              "label": "Keep it quietly underneath"
            },
            {
              "value": "0",
              "label": "Replace it (voice only)"
            }
          ]
        },
        {
          "id": "out",
          "label": "Save dubbed video as",
          "type": "savefile",
          "required": true,
          "filters": [
            {
              "name": "MP4 video",
              "extensions": [
                "mp4"
              ]
            }
          ]
        }
      ],
      "prepare": [
        {
          "cues": "subs",
          "sets": "_lines",
          "times": "_times"
        },
        {
          "tool": "speak",
          "forEach": "_lines",
          "ext": ".wav",
          "collect": "_parts",
          "argv": [
            "--supertonic-duration-predictor={_selfDir}/extras/voice/sherpa-onnx-supertonic-3-tts-int8-2026-05-11/duration_predictor.int8.onnx",
            "--supertonic-text-encoder={_selfDir}/extras/voice/sherpa-onnx-supertonic-3-tts-int8-2026-05-11/text_encoder.int8.onnx",
            "--supertonic-vector-estimator={_selfDir}/extras/voice/sherpa-onnx-supertonic-3-tts-int8-2026-05-11/vector_estimator.int8.onnx",
            "--supertonic-vocoder={_selfDir}/extras/voice/sherpa-onnx-supertonic-3-tts-int8-2026-05-11/vocoder.int8.onnx",
            "--supertonic-tts-json={_selfDir}/extras/voice/sherpa-onnx-supertonic-3-tts-int8-2026-05-11/tts.json",
            "--supertonic-unicode-indexer={_selfDir}/extras/voice/sherpa-onnx-supertonic-3-tts-int8-2026-05-11/unicode_indexer.bin",
            "--supertonic-voice-style={_selfDir}/extras/voice/sherpa-onnx-supertonic-3-tts-int8-2026-05-11/voice.bin",
            "--lang={lang}",
            "--sid={voice}",
            "--speed={speed}",
            "--num-threads=4",
            "--output-filename={tmp}",
            "{item}"
          ]
        },
        {
          "dubTrack": "_parts",
          "times": "_times",
          "to": "dub.wav",
          "sets": "_dub"
        }
      ],
      "argv": [
        "-y",
        "-i",
        {
          "field": "input"
        },
        "-i",
        {
          "fmt": "{_dub}"
        },
        "-filter_complex",
        {
          "fmt": "[0:a]volume={original}[b];[1:a]aresample=48000,volume=1.3[d];[b][d]amix=inputs=2:duration=first:normalize=0[a]"
        },
        "-map",
        "0:v",
        "-map",
        "[a]",
        "-vcodec",
        "copy",
        "-acodec",
        "aac",
        "-ab",
        "192k",
        "-movflags",
        "+faststart",
        {
          "field": "out"
        }
      ],
      "openAfter": "out",
      "successMessage": "Dubbed video ready.",
      "helpArgs": [
        [
          "-h",
          "full"
        ]
      ]
    },
