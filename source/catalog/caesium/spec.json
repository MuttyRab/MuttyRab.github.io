{
  "id": "caesium",
  "name": "Image Compressor",
  "tagline": "Shrink photos and images for email, websites and upload limits — compress, resize and convert to JPG or WebP, a whole folder at a time.",
  "keywords": [
    "compress images",
    "reduce image size",
    "resize photos",
    "image compressor",
    "jpg to webp",
    "caesium"
  ],
  "tier": "pro",
  "status": "live",
  "upstream": {
    "repo": "Lymphatus/caesium-clt",
    "stars": 585,
    "displayName": "Caesium",
    "license": "Apache-2.0",
    "homepage": "https://saerasoft.com/caesium"
  },
  "binary": {
    "name": "caesiumclt",
    "version": "1.5.0",
    "assets": {
      "linux-x64": {
