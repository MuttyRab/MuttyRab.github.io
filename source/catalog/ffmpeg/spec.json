  "actions": [
    {
      "id": "compress",
      "label": "Compress / convert to MP4",
      "runLabel": "Compress",
      "description": "Make a video much smaller (or turn any video into a widely playable MP4). Lower quality and smaller size = smaller file.",
      "helpArgs": [
        [
          "-h",
          "full"
        ]
      ],
      "fields": [
        {
          "id": "input",
          "label": "Video",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "Video",
              "extensions": [
                "mp4",
                "mov",
                "mkv",
                "avi",
                "webm",
                "m4v",
                "wmv",
                "flv",
                "3gp"
              ]
            }
          ]
        },
        {
          "id": "quality",
          "label": "Quality",
          "type": "select",
          "default": "28",
          "options": [
            {
              "value": "20",
              "label": "High (bigger file)"
            },
            {
              "value": "24",
              "label": "Good"
            },
            {
              "value": "28",
              "label": "Small — great for sharing"
            },
            {
              "value": "32",
              "label": "Tiny — e.g. Discord / email limits"
            }
          ]
        },
        {
          "id": "size",
          "label": "Resolution",
          "type": "select",
          "default": "keep",
          "options": [
            {
              "value": "keep",
              "label": "Keep original"
            },
            {
              "value": "1080",
              "label": "Max 1080p"
            },
            {
              "value": "720",
              "label": "Max 720p"
            },
            {
              "value": "480",
              "label": "Max 480p (smallest)"
            }
          ]
        },
        {
          "id": "audio",
          "label": "Sound",
          "type": "select",
          "default": "keep",
          "options": [
            {
              "value": "keep",
              "label": "Keep sound"
            },
            {
              "value": "remove",
              "label": "Remove sound"
            }
          ]
        },
        {
          "id": "out",
          "label": "Save as",
          "type": "savefile",
          "required": true,
          "filters": [
            {
              "name": "MP4 video",
              "extensions": [
                "mp4"
              ]
            }
          ]
        }
      ],
      "argv": [
        "-y",
        "-i",
        {
          "field": "input"
        },
        "-vcodec",
        "libx264",
        "-crf",
        {
          "field": "quality"
        },
        "-preset",
        "medium",
        "-pix_fmt",
        "yuv420p",
        {
          "when": "size",
          "equals": "1080",
          "argv": [
            "-vf",
            "scale=-2:min(1080\\,ih)"
          ]
        },
        {
          "when": "size",
          "equals": "720",
          "argv": [
            "-vf",
            "scale=-2:min(720\\,ih)"
          ]
        },
        {
          "when": "size",
          "equals": "480",
          "argv": [
            "-vf",
            "scale=-2:min(480\\,ih)"
          ]
        },
        {
          "when": "audio",
          "equals": "keep",
          "argv": [
            "-acodec",
            "aac",
            "-ab",
            "128k"
          ]
        },
        {
          "when": "audio",
          "equals": "remove",
          "argv": [
            "-an"
          ]
        },
        "-movflags",
        "+faststart",
        {
          "field": "out"
        }
      ],
      "openAfter": "out",
      "successMessage": "Done — compare the new file size in the folder."
    },
    {
      "id": "compress-size",
      "label": "Compress to a file size",
      "runLabel": "Compress",
      "description": "Make a video fit under a size limit (e.g. 10 MB for Discord, 25 MB for email). Works out the bitrate from the video's length and lowers the resolution only when it has to. Lands a little under the target; very long videos may need trimming first.",
      "helpArgs": [
        [
          "-h",
          "full"
        ]
      ],
      "fields": [
        {
          "id": "input",
          "label": "Video",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "Video",
              "extensions": [
                "mp4",
                "mov",
                "mkv",
                "avi",
                "webm",
                "m4v",
                "wmv",
                "flv",
                "3gp"
              ]
            }
          ]
        },
        {
          "id": "mb",
          "label": "Target size (MB)",
          "type": "number",
          "default": "10"
        },
        {
          "id": "audio",
          "label": "Sound",
          "type": "select",
          "default": "keep",
          "options": [
            {
              "value": "keep",
              "label": "Keep sound"
            },
            {
              "value": "remove",
              "label": "Remove sound (more room for picture)"
            }
          ]
        },
        {
          "id": "out",
          "label": "Save as",
          "type": "savefile",
          "required": true,
          "filters": [
            {
              "name": "MP4 video",
              "extensions": [
                "mp4"
              ]
            }
          ]
        }
      ],
      "prepare": [
        {
          "tool": "ffmpeg",
          "argv": [
            "-hide_banner",
            "-i",
            "{input}"
          ],
          "captureStderr": "_probe"
        },
        {
          "pick": "_probe",
          "transform": "sizePlan",
          "size": "mb",
          "audio": "audio",
          "sets": "_vbr",
          "buf": "_buf",
          "height": "_h"
        }
      ],
      "argv": [
        "-y",
        "-i",
        {
          "field": "input"
        },
        "-vcodec",
        "libx264",
        "-b",
        {
          "fmt": "{_vbr}k"
        },
        "-maxrate",
        {
          "fmt": "{_vbr}k"
        },
        "-bufsize",
        {
          "fmt": "{_buf}k"
        },
        "-preset",
        "medium",
        "-pix_fmt",
        "yuv420p",
        "-vf",
        {
          "fmt": "scale=-2:'min({_h},ih)'"
        },
        {
          "when": "audio",
          "equals": "keep",
          "argv": [
            "-acodec",
            "aac",
            "-ab",
            "96k"
          ]
        },
        {
          "when": "audio",
          "equals": "remove",
          "argv": [
            "-an"
          ]
        },
        "-movflags",
        "+faststart",
        {
          "field": "out"
        }
      ],
      "openAfter": "out",
      "successMessage": "Done — the new file should be just under the size you asked for."
    },
    {
      "id": "audio",
      "label": "Extract audio (MP3)",
      "runLabel": "Extract",
      "description": "Save just the sound of a video as an MP3 — for music, lectures or podcasts.",
      "helpArgs": [
        [
          "-h",
          "full"
        ]
      ],
      "fields": [
        {
          "id": "input",
          "label": "Video",
          "type": "file",
          "required": true
        },
        {
          "id": "bitrate",
          "label": "Audio quality",
          "type": "select",
          "default": "192k",
          "options": [
            {
              "value": "128k",
              "label": "Standard (128 kbps)"
            },
            {
              "value": "192k",
              "label": "High (192 kbps)"
            },
            {
              "value": "320k",
              "label": "Best (320 kbps)"
            }
          ]
        },
        {
          "id": "out",
          "label": "Save as",
          "type": "savefile",
          "required": true,
          "filters": [
            {
              "name": "MP3 audio",
              "extensions": [
                "mp3"
              ]
            }
          ]
        }
      ],
      "argv": [
        "-y",
        "-i",
        {
          "field": "input"
        },
        "-vn",
        "-acodec",
        "libmp3lame",
        "-ab",
        {
          "field": "bitrate"
        },
        {
          "field": "out"
        }
      ],
      "openAfter": "out",
      "successMessage": "Audio saved."
    },
    {
      "id": "audio-convert",
      "label": "Convert audio",
      "runLabel": "Convert",
      "description": "Convert any audio (or the sound of a video) to MP3, M4A, WAV or FLAC — and optionally even out the volume so quiet recordings are easy to hear.",
      "mcpDescription": "Convert an audio or video file's sound to mp3, m4a, wav or flac. normalize=true applies EBU R128 loudness normalization (loudnorm) — good for voice recordings and podcasts.",
      "helpArgs": [
        [
          "-h",
          "full"
        ]
      ],
      "fields": [
        {
          "id": "input",
          "label": "Audio or video file",
          "type": "file",
          "required": true
        },
        {
          "id": "format",
          "label": "Convert to",
          "type": "select",
          "default": "mp3",
          "options": [
            {
              "value": "mp3",
              "label": "MP3 (works everywhere)"
            },
            {
              "value": "m4a",
              "label": "M4A / AAC (Apple-friendly)"
            },
            {
              "value": "wav",
              "label": "WAV (uncompressed)"
            },
            {
              "value": "flac",
              "label": "FLAC (lossless, smaller than WAV)"
            }
          ]
        },
        {
          "id": "normalize",
          "label": "Even out the volume (loudness normalization)",
          "type": "checkbox"
        },
        {
          "id": "out",
          "label": "Save as",
          "type": "savefile",
          "required": true,
          "help": "Use the matching extension, e.g. talk.mp3"
        }
      ],
      "argv": [
        "-y",
        "-i",
        {
          "field": "input"
        },
        "-vn",
        {
          "field": "normalize",
          "flag": "-af"
        },
        {
          "when": "normalize",
          "argv": [
            "loudnorm=I=-16:TP=-1.5:LRA=11"
          ]
        },
        {
          "when": "format",
          "equals": "mp3",
          "argv": [
            "-acodec",
            "libmp3lame",
            "-ab",
            "192k"
          ]
        },
        {
          "when": "format",
          "equals": "m4a",
          "argv": [
            "-acodec",
            "aac",
            "-ab",
            "192k"
          ]
        },
        {
          "when": "format",
          "equals": "wav",
          "argv": [
            "-acodec",
            "pcm_s16le"
          ]
        },
        {
          "when": "format",
          "equals": "flac",
          "argv": [
            "-acodec",
            "flac"
          ]
        },
        {
          "field": "out"
        }
      ],
      "openAfter": "out",
      "successMessage": "Converted."
    },
    {
      "id": "gif",
      "label": "Make a GIF",
      "runLabel": "Make GIF",
      "description": "Turn a short part of a video into a good-looking animated GIF.",
      "helpArgs": [
        [
          "-h",
          "full"
        ]
      ],
      "fields": [
        {
          "id": "input",
          "label": "Video",
          "type": "file",
          "required": true
        },
        {
          "id": "start",
          "label": "Start at",
          "type": "text",
          "default": "0",
          "placeholder": "seconds or 00:01:30",
          "help": "Where the GIF begins. Seconds (e.g. 12.5) or hh:mm:ss."
        },
        {
          "id": "duration",
          "label": "Length (seconds)",
          "type": "number",
          "default": "5"
        },
        {
          "id": "width",
          "label": "Width",
          "type": "select",
          "default": "480",
          "options": [
            {
              "value": "320",
              "label": "Small (320 px)"
            },
            {
              "value": "480",
              "label": "Medium (480 px)"
            },
            {
              "value": "720",
              "label": "Large (720 px)"
            }
          ]
        },
        {
          "id": "out",
          "label": "Save as",
          "type": "savefile",
          "required": true,
          "filters": [
            {
              "name": "GIF",
              "extensions": [
                "gif"
              ]
            }
          ]
        }
      ],
      "argv": [
        "-y",
        {
          "field": "start",
          "flag": "-ss"
        },
        {
          "field": "duration",
          "flag": "-t"
        },
        "-i",
        {
          "field": "input"
        },
        {
          "when": "width",
          "equals": "320",
          "argv": [
            "-vf",
            "fps=12,scale=320:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse"
          ]
        },
        {
          "when": "width",
          "equals": "480",
          "argv": [
            "-vf",
            "fps=12,scale=480:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse"
          ]
        },
        {
          "when": "width",
          "equals": "720",
          "argv": [
            "-vf",
            "fps=12,scale=720:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse"
          ]
        },
        "-loop",
        "0",
        {
          "field": "out"
        }
      ],
      "openAfter": "out",
      "successMessage": "GIF saved."
    },
    {
