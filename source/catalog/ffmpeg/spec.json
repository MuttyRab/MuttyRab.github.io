    {
      "id": "loudness",
      "label": "Fix volume (normalize loudness)",
      "runLabel": "Fix volume",
      "description": "Makes quiet or uneven recordings sound loud and even — like a podcast or YouTube video. Works on audio and video; the picture is not touched.",
      "mcpDescription": "Normalize the loudness of an audio or video file on the user's computer (EBU R128 loudnorm): makes quiet or uneven recordings loud and consistent at a chosen target (podcast/YouTube −14/−16 LUFS, broadcast −23). Video is copied unchanged. Use whenever the user says audio is too quiet, too loud, uneven, or wants it 'normalized' or 'podcast-ready'.",
      "fields": [
        {
          "id": "input",
          "label": "Recording or video",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "Audio & video",
              "extensions": [
                "mp3",
                "m4a",
                "wav",
                "aac",
                "ogg",
                "flac",
                "mp4",
                "mov",
                "mkv",
                "webm",
                "m4v"
              ]
            }
          ]
        },
        {
          "id": "target",
          "label": "Target loudness",
          "type": "select",
          "default": "loudnorm=I=-16:TP=-1.5:LRA=11",
          "options": [
            {
              "value": "loudnorm=I=-14:TP=-1:LRA=11",
              "label": "Loud — YouTube / Spotify (−14 LUFS)"
            },
            {
              "value": "loudnorm=I=-16:TP=-1.5:LRA=11",
              "label": "Podcast / voice (−16 LUFS)"
            },
            {
              "value": "loudnorm=I=-23:TP=-2:LRA=15",
              "label": "Broadcast (−23 LUFS)"
            }
          ]
        },
        {
          "id": "kind",
          "label": "Output is",
          "type": "select",
          "default": "audio",
          "options": [
            {
              "value": "audio",
              "label": "Audio file"
            },
            {
              "value": "video",
              "label": "Video (keep the picture)"
            }
          ]
        },
        {
          "id": "out",
          "label": "Save as",
          "type": "savefile",
          "required": true,
          "filters": [
            {
              "name": "Audio or video",
              "extensions": [
                "mp3",
                "m4a",
                "wav",
                "mp4",
                "mov",
                "mkv"
              ]
            }
          ]
        }
      ],
      "argv": [
        "-y",
        "-i",
        {
          "field": "input"
        },
        {
          "field": "target",
          "flag": "-af"
        },
        {
          "when": "kind",
          "equals": "video",
          "argv": [
            "-vcodec",
            "copy"
          ]
        },
        {
          "when": "kind",
          "equals": "audio",
          "argv": [
            "-vn"
          ]
        },
        "-ar",
        "48000",
        {
          "field": "out"
        }
      ],
      "openAfter": "out",
      "successMessage": "Volume fixed.",
      "helpArgs": [
        [
          "-h",
          "full"
        ]
      ]
    },
    {
      "id": "join",
      "label": "Join videos into one",
      "runLabel": "Join videos",
      "description": "Puts several clips one after another into a single MP4 — even if they come from different phones or cameras (different sizes, formats or frame rates). Clips are joined in the order you add them.",
      "mcpDescription": "Join (merge/concatenate) several video clips on the user's computer into one MP4, in the order given — works even when the clips differ in format, resolution or frame rate (each is converted to the same format first, then joined). Choose the output size (1080p/720p, landscape or portrait). Use whenever the user wants to combine, merge, stitch or join videos. Clips should all have sound or all be silent.",
      "fields": [
        {
          "id": "inputs",
          "label": "Clips (in order)",
          "type": "files",
          "required": true,
          "filters": [
            {
              "name": "Video",
              "extensions": [
                "mp4",
                "mov",
                "m4v",
                "mkv",
                "webm",
                "avi",
                "3gp",
                "wmv",
                "flv"
              ]
            }
          ]
        },
        {
          "id": "size",
          "label": "Output size",
          "type": "select",
          "default": "1920:1080",
          "options": [
            {
              "value": "1920:1080",
