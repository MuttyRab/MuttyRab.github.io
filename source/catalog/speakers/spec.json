      }
    ]
  },
  "actions": [
    {
      "id": "diarize",
      "label": "Who spoke when",
      "runLabel": "Find speakers",
      "description": "Pick a meeting, interview or podcast recording. You get a timeline of who is speaking when (Speaker 1, Speaker 2, …). Combine it with a transcript to see who said what.",
      "mcpDescription": "Detect who is speaking when in an audio or video recording on the user's computer (speaker diarization, offline): returns lines like '[00:01:05 → 00:01:20] Speaker 2'. Use for meetings, interviews, podcasts and calls when the user wants speaker labels or 'who said what' — run transcribe_transcribe with timestamps as well and match the times to label each line of the transcript with its speaker. Set `speakers` if the number of people is known.",
      "fields": [
        {
          "id": "input",
          "label": "Recording or video",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "Audio & video",
              "extensions": [
                "mp3",
                "m4a",
                "wav",
                "aac",
                "ogg",
                "opus",
                "flac",
                "wma",
                "mp4",
                "mov",
                "mkv",
                "webm",
                "avi",
                "m4v"
              ]
            }
          ]
        },
        {
          "id": "speakers",
          "label": "Number of speakers",
          "type": "select",
          "default": "",
          "options": [
            {
              "value": "",
              "label": "Detect automatically"
            },
            {
              "value": "2",
              "label": "2"
            },
            {
              "value": "3",
              "label": "3"
            },
            {
              "value": "4",
              "label": "4"
            },
            {
              "value": "5",
              "label": "5"
            },
            {
              "value": "6",
              "label": "6"
            },
            {
              "value": "7",
              "label": "7"
            },
            {
              "value": "8",
              "label": "8"
            }
          ]
        },
        {
          "id": "out",
          "label": "Also save the timeline as (optional)",
          "type": "savefile",
          "filters": [
            {
              "name": "Text",
              "extensions": [
                "txt"
              ]
            }
          ]
        }
      ],
      "prepare": {
        "tool": "ffmpeg",
        "argv": [
          "-y",
          "-i",
          "{input}",
          "-vn",
          "-ac",
          "1",
          "-ar",
          "16000",
          "-c:a",
          "pcm_s16le",
          "{tmp}"
        ],
        "replaces": "input",
        "ext": ".wav"
      },
      "cwd": "tool",
      "saveStdout": {
        "field": "out",
        "transform": "speakers"
      },
      "maxOutput": 40000,
      "argv": [
        "--segmentation.pyannote-model=extras/seg/sherpa-onnx-pyannote-segmentation-3-0/model.int8.onnx",
        "--embedding.model=extras/emb/nemo_en_titanet_small.onnx",
        "--segmentation.num-threads=4",
        "--embedding.num-threads=4",
        {
          "field": "speakers",
          "flag": "--clustering.num-clusters",
          "join": "="
        },
        {
          "field": "input"
        }
      ],
      "successMessage": "Speakers found.",
      "helpArgs": [
        [
          "--help"
        ]
      ]
    }
  ]
}
