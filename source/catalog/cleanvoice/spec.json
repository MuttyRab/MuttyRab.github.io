  "actions": [
    {
      "id": "denoise",
      "label": "Remove background noise",
      "runLabel": "Clean up",
      "description": "Pick a voice recording or video. Background noise is removed and a clean copy is saved; your original is not changed. Best for speech (memos, interviews, lectures, calls), not music.",
      "mcpDescription": "Remove background noise (hiss, hum, fans, traffic, room noise) from a speech recording on the user's computer — any audio or video file — offline, and save a cleaned .wav copy (16 kHz mono, optimised for speech). Use whenever the user wants to clean up, denoise or improve the audio of a voice memo, interview, podcast, lecture, call or video narration. Combine with transcription for better transcripts of noisy audio.",
      "fields": [
        {
          "id": "input",
          "label": "Recording or video",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "Audio & video",
              "extensions": [
                "mp3",
                "m4a",
                "wav",
                "aac",
                "ogg",
                "opus",
                "flac",
                "wma",
                "mp4",
                "mov",
                "mkv",
                "webm",
                "avi",
                "m4v"
              ]
            }
          ]
        },
        {
          "id": "out",
          "label": "Save cleaned audio as",
          "type": "savefile",
          "required": true,
          "filters": [
            {
              "name": "WAV audio",
              "extensions": [
                "wav"
              ]
            }
          ]
        }
      ],
      "prepare": {
        "tool": "ffmpeg",
        "argv": [
          "-y",
          "-i",
          "{input}",
          "-vn",
          "-ac",
          "1",
          "-ar",
          "16000",
          "-c:a",
          "pcm_s16le",
          "{tmp}"
        ],
        "replaces": "input",
        "ext": ".wav"
      },
      "cwd": "tool",
      "argv": [
        "--speech-denoiser-gtcrn-model=extras/model/gtcrn_simple.onnx",
        {
          "field": "input",
          "flag": "--input-wav",
          "join": "="
        },
        {
          "field": "out",
          "flag": "--output-wav",
          "join": "="
        }
      ],
      "openAfter": "out",
      "successMessage": "Cleaned copy saved.",
      "helpArgs": [
        [
          "--help"
        ]
      ]
    }
  ]
}
