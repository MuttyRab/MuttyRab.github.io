{
  "id": "watch",
  "product": "essentials",
  "name": "Video to Screenshots & Transcript",
  "tagline": "Turn a video into timed screenshots and a timestamped transcript — so you (or your AI) can see and read what happens in it.",
  "keywords": [
    "let ai watch a video",
    "video to screenshots",
    "video to text with screenshots",
    "summarize a video with ai",
    "screen recording to tutorial",
    "extract frames from video",
    "video transcript with screenshots",
    "watch video mcp"
  ],
  "tier": "pro",
  "status": "live",
  "upstream": {
    "repo": "FFmpeg/FFmpeg",
    "stars": 50000,
    "displayName": "FFmpeg + Whisper",
    "license": "GPL (FFmpeg static build), Apache-2.0/MIT (Whisper via sherpa-onnx)",
    "homepage": "https://ffmpeg.org"
  },
  "binary": {
    "name": "ffmpeg",
    "version": "6.1.1",
    "assets": {
      "linux-x64": {
        "url": "https://github.com/eugeneware/ffmpeg-static/releases/download/b6.1.1/ffmpeg-linux-x64",
        "path": "ffmpeg",
        "sha256": "e7e7fb30477f717e6f55f9180a70386c62677ef8a4d4d1a5d948f4098aa3eb99"
      },
      "darwin-arm64": {
        "url": "https://github.com/eugeneware/ffmpeg-static/releases/download/b6.1.1/ffmpeg-darwin-arm64",
        "path": "ffmpeg",
        "sha256": "a90e3db6a3fd35f6074b013f948b1aa45b31c6375489d39e572bea3f18336584"
      },
      "darwin-x64": {
        "url": "https://github.com/eugeneware/ffmpeg-static/releases/download/b6.1.1/ffmpeg-darwin-x64",
        "path": "ffmpeg",
        "sha256": "ebdddc936f61e14049a2d4b549a412b8a40deeff6540e58a9f2a2da9e6b18894"
      },
      "win32-x64": {
        "url": "https://github.com/eugeneware/ffmpeg-static/releases/download/b6.1.1/ffmpeg-win32-x64",
        "path": "ffmpeg.exe",
        "sha256": "04e1307997530f9cf2fe35cba2ca7e8875ca91da02f89d6c7243df819c94ad00"
      }
    }
  },
  "actions": [
    {
      "id": "video",
      "label": "Screenshots + transcript",
      "runLabel": "Make screenshots & transcript",
      "description": "Pick a video and a folder. You get a screenshot every few seconds (frame_0001.jpg is the start, then one every interval) and transcript.txt with what is said and when. Great for writing a how-to from a screen recording, notes from a lecture, or finding a moment in a long video. Silent videos work too (screenshots only).",
      "mcpDescription": "Let the AI 'watch' a video on the user's computer, offline: saves a screenshot every `every` seconds into `outDir` (frame_0001.jpg = 0:00, frame_0002.jpg = `every` seconds later, and so on; at most 300) plus transcript.txt with timestamped speech ([hh:mm:ss] lines, Whisper). Then open the screenshots and the transcript yourself to answer questions about the video, summarise it, write step-by-step docs or a tutorial from a screen recording, find when something is shown or said, or pick timestamps for clips. Use `every` 2 for fast screen recordings, 5 for normal videos, 15-30 for long lectures or meetings. Silent videos are fine (the transcript then says no speech was found).",
      "fields": [
        {
          "id": "input",
          "label": "Video",
          "type": "file",
          "required": true,
          "filters": [
            {
              "name": "Video",
              "extensions": [
                "mp4",
                "mov",
                "webm",
                "mkv",
                "m4v",
                "avi"
              ]
            }
          ]
        },
        {
          "id": "every",
          "label": "A screenshot every",
          "type": "select",
          "default": "5",
          "options": [
            {
              "value": "2",
              "label": "2 seconds (screen recordings)"
            },
            {
              "value": "5",
              "label": "5 seconds"
            },
            {
              "value": "15",
              "label": "15 seconds"
            },
            {
              "value": "30",
              "label": "30 seconds (long talks)"
            }
          ]
        },
        {
          "id": "language",
          "label": "Spoken language",
          "type": "select",
          "default": "",
          "options": [
            {
              "value": "",
              "label": "Detect automatically"
            },
            {
              "value": "en",
              "label": "English"
            },
            {
              "value": "es",
              "label": "Spanish"
            },
            {
              "value": "fr",
              "label": "French"
            },
            {
              "value": "de",
              "label": "German"
            },
            {
              "value": "it",
              "label": "Italian"
            },
            {
              "value": "pt",
              "label": "Portuguese"
            },
            {
              "value": "nl",
              "label": "Dutch"
            },
            {
              "value": "ru",
              "label": "Russian"
            },
            {
              "value": "uk",
              "label": "Ukrainian"
            },
            {
              "value": "pl",
              "label": "Polish"
            },
            {
              "value": "tr",
              "label": "Turkish"
            },
            {
              "value": "ar",
              "label": "Arabic"
            },
            {
              "value": "he",
              "label": "Hebrew"
            },
            {
              "value": "hi",
              "label": "Hindi"
            },
            {
              "value": "zh",
              "label": "Chinese"
            },
            {
              "value": "ja",
              "label": "Japanese"
            },
            {
              "value": "ko",
              "label": "Korean"
            }
          ]
        },
        {
          "id": "outDir",
          "label": "Save into folder",
          "type": "folder",
          "required": true
        }
      ],
      "prepare": [
        {
          "tool": "ffmpeg",
          "optional": true,
          "argv": [
            "-y",
            "-i",
            "{input}",
            "-vn",
            "-ac",
            "1",
            "-ar",
            "16000",
            "-af",
            "apad=pad_dur=1",
            "-c:a",
            "pcm_s16le",
            "{tmp:audio.wav}"
          ],
          "sets": {
            "_audio": "audio.wav"
          }
        },
        {
          "tool": "transcribe",
          "cwd": "tool",
          "optional": true,
          "requires": "_audio",
          "argv": [
            "--silero-vad-model=extras/vad/silero_vad.onnx",
            "--whisper-encoder=extras/model/sherpa-onnx-whisper-base/base-encoder.int8.onnx",
            "--whisper-decoder=extras/model/sherpa-onnx-whisper-base/base-decoder.int8.onnx",
            "--tokens=extras/model/sherpa-onnx-whisper-base/base-tokens.txt",
            "--num-threads=4",
            "--whisper-language={language}",
            "{_audio}"
          ],
          "captureStdout": "_speech"
        },
        {
          "write": "transcript.txt",
          "to": "{outDir}/transcript.txt",
          "from": "_speech",
          "transform": "segments",
          "emptyText": "(No speech was found in this video.)"
        }
      ],
      "argv": [
        "-y",
        "-i",
        {
          "field": "input"
        },
        "-vf",
        {
          "fmt": "fps=1/{every},scale='min(1280,iw)':-2"
        },
        "-qscale",
        "3",
        "-vframes",
        "300",
        {
          "fmt": "{outDir}/frame_%04d.jpg"
        }
      ],
      "openAfter": "outDir",
      "successMessage": "Screenshots and transcript.txt saved in the folder.",
      "helpArgs": [
        [
          "-h",
          "full"
        ]
      ],
      "returnImages": {
        "field": "outDir",
        "max": 8
      }
    },
    {
      "id": "screen",
      "label": "Watch my screen (record + explain)",
      "runLabel": "Start recording",
      "description": "Records your screen — and your voice, if a microphone is available — for the time you choose, so you can show your AI something instead of describing it: a bug, a task you do every week, how a program works. You get a screenshot each time the screen changes (named by the second it happened) plus a timestamped transcript of what you said. On a Mac, allow Screen Recording (and Microphone) for the app that runs this, the first time.",
      "mcpDescription": "Watch the user's screen live: records the screen (and microphone, when available) for `seconds`, while the user shows you something and explains it out loud — reproducing a bug, a task to automate, how an app is used. Saves into `outDir`: frame_<N>.jpg each time the screen changes (N = tenths of a second from the start, so frame_123.jpg = 12.3 s; only changed screens, at most 300), transcript.txt with [hh:mm:ss] lines of what the user said, and recording.mp4. BEFORE calling, tell the user: 'Recording your screen for N seconds starts now — show me and talk me through it.' Afterwards open transcript.txt and the frames to understand what happened. macOS needs Screen Recording (and Microphone) permission for the app that runs the MCP server; Linux needs an X11 session (not Wayland).",
      "fields": [
        {
          "id": "seconds",
          "label": "Record for",
          "type": "select",
          "default": "60",
          "options": [
            {
              "value": "20",
              "label": "20 seconds"
            },
            {
              "value": "60",
              "label": "1 minute"
            },
            {
              "value": "120",
              "label": "2 minutes"
            },
            {
              "value": "300",
              "label": "5 minutes"
            }
          ]
        },
        {
          "id": "mic",
          "label": "Also record my voice",
          "type": "select",
          "default": "yes",
          "options": [
            {
              "value": "yes",
              "label": "Yes — I'll explain while I show"
            },
            {
              "value": "",
              "label": "No — screen only"
            }
          ]
        },
        {
          "id": "language",
          "label": "Spoken language",
          "type": "select",
          "default": "",
          "options": [
            {
              "value": "",
              "label": "Detect automatically"
            },
            {
              "value": "en",
              "label": "English"
            },
            {
              "value": "es",
              "label": "Spanish"
            },
            {
              "value": "fr",
              "label": "French"
            },
            {
              "value": "de",
              "label": "German"
            },
            {
              "value": "it",
              "label": "Italian"
            },
            {
              "value": "pt",
              "label": "Portuguese"
            },
            {
              "value": "nl",
              "label": "Dutch"
            },
            {
              "value": "ru",
              "label": "Russian"
            },
            {
              "value": "uk",
              "label": "Ukrainian"
            },
            {
              "value": "pl",
              "label": "Polish"
            },
            {
              "value": "tr",
              "label": "Turkish"
            },
            {
              "value": "ar",
              "label": "Arabic"
            },
            {
              "value": "he",
              "label": "Hebrew"
            },
            {
              "value": "hi",
              "label": "Hindi"
            },
            {
              "value": "zh",
              "label": "Chinese"
            },
            {
              "value": "ja",
              "label": "Japanese"
            },
            {
              "value": "ko",
              "label": "Korean"
            }
          ]
        },
        {
          "id": "outDir",
          "label": "Save into folder",
          "type": "folder",
          "required": true
        }
      ],
      "prepare": [
        {
          "tool": "ffmpeg",
          "when": "_os",
          "equals": "linux",
          "argv": [
            "-y",
            "-f",
            "x11grab",
            "-framerate",
            "10",
            "-i",
            "{_display}",
            "-f",
            "alsa",
            "-i",
            "default",
            "-t",
            "{seconds}",
            "-vcodec",
            "libx264",
            "-preset",
            "ultrafast",
            "-crf",
            "28",
            "-pix_fmt",
            "yuv420p",
            "-acodec",
            "aac",
            "-ab",
            "96k",
            "{tmp:rec.mp4}"
          ],
          "sets": {
            "_rec": "rec.mp4"
          },
          "requires": "mic",
          "optional": true
        },
        {
          "tool": "ffmpeg",
          "when": "_os",
          "equals": "linux",
          "argv": [
            "-y",
            "-f",
            "x11grab",
            "-framerate",
            "10",
            "-i",
            "{_display}",
            "-t",
            "{seconds}",
            "-vcodec",
            "libx264",
            "-preset",
            "ultrafast",
            "-crf",
            "28",
            "-pix_fmt",
            "yuv420p",
            "-an",
            "{tmp:rec.mp4}"
          ],
          "sets": {
            "_rec": "rec.mp4"
          },
          "unless": "_rec"
        },
        {
          "tool": "ffmpeg",
          "when": "_os",
          "equals": "darwin",
          "argv": [
            "-y",
            "-f",
            "avfoundation",
            "-framerate",
            "10",
            "-capture_cursor",
            "1",
            "-i",
            "Capture screen 0:default",
            "-t",
            "{seconds}",
            "-vcodec",
            "libx264",
            "-preset",
            "ultrafast",
            "-crf",
            "28",
            "-pix_fmt",
            "yuv420p",
            "-acodec",
            "aac",
            "-ab",
            "96k",
            "{tmp:rec.mp4}"
          ],
          "sets": {
            "_rec": "rec.mp4"
          },
          "requires": "mic",
          "optional": true
        },
        {
          "tool": "ffmpeg",
          "when": "_os",
          "equals": "darwin",
          "argv": [
            "-y",
            "-f",
            "avfoundation",
            "-framerate",
            "10",
            "-capture_cursor",
            "1",
            "-i",
            "Capture screen 0:none",
            "-t",
            "{seconds}",
            "-vcodec",
            "libx264",
            "-preset",
            "ultrafast",
            "-crf",
            "28",
            "-pix_fmt",
            "yuv420p",
            "-an",
            "{tmp:rec.mp4}"
          ],
          "sets": {
            "_rec": "rec.mp4"
          },
          "unless": "_rec"
        },
        {
          "tool": "ffmpeg",
          "when": "_os",
          "equals": "win32",
          "requires": "mic",
          "argv": [
            "-hide_banner",
            "-list_devices",
            "true",
            "-f",
            "dshow",
            "-i",
            "dummy"
          ],
          "captureStderr": "_devices"
        },
        {
          "pick": "_devices",
          "transform": "dshowAudio",
          "sets": "_mic",
          "requires": "_devices"
        },
        {
          "tool": "ffmpeg",
          "when": "_os",
          "equals": "win32",
          "argv": [
            "-y",
            "-f",
            "gdigrab",
            "-framerate",
            "10",
            "-i",
            "desktop",
            "-f",
            "dshow",
            "-i",
            "audio={_mic}",
            "-t",
            "{seconds}",
            "-vcodec",
            "libx264",
            "-preset",
            "ultrafast",
            "-crf",
            "28",
            "-pix_fmt",
            "yuv420p",
            "-acodec",
            "aac",
            "-ab",
            "96k",
            "{tmp:rec.mp4}"
          ],
          "sets": {
            "_rec": "rec.mp4"
          },
          "requires": "_mic",
          "optional": true
        },
        {
          "tool": "ffmpeg",
          "when": "_os",
          "equals": "win32",
          "argv": [
            "-y",
            "-f",
            "gdigrab",
            "-framerate",
            "10",
            "-i",
            "desktop",
            "-t",
            "{seconds}",
            "-vcodec",
            "libx264",
            "-preset",
            "ultrafast",
            "-crf",
            "28",
            "-pix_fmt",
            "yuv420p",
            "-an",
            "{tmp:rec.mp4}"
          ],
          "sets": {
            "_rec": "rec.mp4"
          },
          "unless": "_rec"
        },
        {
          "tool": "ffmpeg",
          "optional": true,
          "requires": "_rec",
          "argv": [
            "-y",
            "-i",
            "{_rec}",
            "-vn",
            "-ac",
            "1",
            "-ar",
            "16000",
            "-af",
            "apad=pad_dur=1",
            "-c:a",
            "pcm_s16le",
            "{tmp:audio.wav}"
          ],
          "sets": {
            "_audio": "audio.wav"
          }
        },
        {
          "tool": "transcribe",
          "cwd": "tool",
          "optional": true,
          "requires": "_audio",
          "argv": [
            "--silero-vad-model=extras/vad/silero_vad.onnx",
            "--whisper-encoder=extras/model/sherpa-onnx-whisper-base/base-encoder.int8.onnx",
            "--whisper-decoder=extras/model/sherpa-onnx-whisper-base/base-decoder.int8.onnx",
            "--tokens=extras/model/sherpa-onnx-whisper-base/base-tokens.txt",
            "--num-threads=4",
            "--whisper-language={language}",
            "{_audio}"
          ],
          "captureStdout": "_speech"
        },
        {
          "write": "transcript.txt",
          "to": "{outDir}/transcript.txt",
          "from": "_speech",
          "transform": "segments",
          "emptyText": "(Nothing was said during the recording, or no microphone was available.)"
        }
      ],
      "argv": [
        "-y",
        "-i",
        {
          "fmt": "{_rec}"
        },
        "-vf",
        "fps=10,select='eq(n\\,0)+gt(scene\\,0.008)',scale='min(1280,iw)':-2",
        "-fps_mode",
        "vfr",
        "-frame_pts",
        "1",
        "-qscale",
        "3",
        "-vframes",
        "300",
        {
          "fmt": "{outDir}/frame_%d.jpg"
        },
        "-map",
        "0",
        "-c",
        "copy",
        {
          "fmt": "{outDir}/recording.mp4"
        }
      ],
      "openAfter": "outDir",
      "successMessage": "Recording saved — screenshots of every change and a transcript.",
      "helpArgs": [
        [
          "-h",
          "full"
        ]
      ],
      "returnImages": {
        "field": "outDir",
        "max": 8
      }
    },
    {
      "id": "camera",
      "label": "Look through my webcam",
      "runLabel": "Take photo",
      "description": "Takes a photo with your computer's camera after a short countdown, so your AI can see something physical: a part you're holding up, a whiteboard, a handwritten note, a plant, a 3D print in progress. Nothing is uploaded by this app; the photo is saved where you choose.",
      "mcpDescription": "Take a photo with the user's webcam and return it to you as an image, so you can see something physical: an object or part the user holds up, a whiteboard, handwriting, a label, a device's lights or screen, a 3D print or plant to check on. `wait` is the countdown in seconds before the photo (gives the camera time to adjust and the user time to position things — ask them to hold the object close and steady). Call it again whenever you need another look; for monitoring something over time, call it on an interval. Use only when the user asks you to look; the photo is saved to `out` on their computer. If no camera is found, ask the user to connect one and allow camera access for GUI Hub (macOS: System Settings → Privacy & Security → Camera).",
      "fields": [
        {
          "id": "wait",
          "label": "Countdown before the photo",
          "type": "select",
          "default": "3",
          "options": [
            {
              "value": "2",
              "label": "2 seconds"
            },
            {
              "value": "3",
              "label": "3 seconds"
            },
            {
              "value": "5",
              "label": "5 seconds"
            },
            {
              "value": "10",
              "label": "10 seconds"
            }
          ]
        },
        {
          "id": "out",
          "label": "Save photo as",
          "type": "savefile",
          "required": true,
          "filters": [
            {
              "name": "JPEG image",
              "extensions": [
                "jpg"
              ]
            }
          ]
        }
      ],
      "prepare": [
        {
          "tool": "ffmpeg",
          "when": "_os",
          "equals": "linux",
          "unless": "_rec",
          "argv": [
            "-y",
            "-f",
            "v4l2",
            "-i",
            "/dev/video0",
            "-t",
            "{wait}",
            "-vcodec",
            "libx264",
            "-preset",
            "ultrafast",
            "-pix_fmt",
            "yuv420p",
            "-an",
            "{tmp:cam.mp4}"
          ],
          "sets": {
            "_rec": "cam.mp4"
          }
        },
        {
          "tool": "ffmpeg",
          "when": "_os",
          "equals": "darwin",
          "unless": "_rec",
          "optional": true,
          "argv": [
            "-y",
            "-f",
            "avfoundation",
            "-framerate",
            "30",
            "-i",
            "default",
            "-t",
            "{wait}",
            "-vcodec",
            "libx264",
            "-preset",
            "ultrafast",
            "-pix_fmt",
            "yuv420p",
            "-an",
            "{tmp:cam.mp4}"
          ],
          "sets": {
            "_rec": "cam.mp4"
          }
        },
        {
          "tool": "ffmpeg",
          "when": "_os",
          "equals": "darwin",
          "unless": "_rec",
          "argv": [
            "-y",
            "-f",
            "avfoundation",
            "-framerate",
            "15",
            "-i",
            "default",
            "-t",
            "{wait}",
            "-vcodec",
            "libx264",
            "-preset",
            "ultrafast",
            "-pix_fmt",
            "yuv420p",
            "-an",
            "{tmp:cam.mp4}"
          ],
          "sets": {
            "_rec": "cam.mp4"
          }
        },
        {
          "tool": "ffmpeg",
          "when": "_os",
          "equals": "win32",
          "unless": "_rec",
          "argv": [
            "-hide_banner",
            "-list_devices",
            "true",
            "-f",
            "dshow",
            "-i",
            "dummy"
          ],
          "captureStderr": "_devices"
        },
        {
          "pick": "_devices",
          "transform": "dshowVideo",
          "sets": "_cam",
          "requires": "_devices"
        },
        {
          "tool": "ffmpeg",
          "when": "_os",
          "equals": "win32",
          "unless": "_rec",
          "argv": [
            "-y",
            "-f",
            "dshow",
            "-i",
            "video={_cam}",
            "-t",
            "{wait}",
            "-vcodec",
            "libx264",
            "-preset",
            "ultrafast",
            "-pix_fmt",
            "yuv420p",
            "-an",
            "{tmp:cam.mp4}"
          ],
          "sets": {
            "_rec": "cam.mp4"
          }
        }
      ],
      "argv": [
        "-y",
        "-i",
        {
          "fmt": "{_rec}"
        },
        "-vf",
        "scale='min(1600,iw)':-2",
        "-update",
        "1",
        "-qscale",
        "2",
        {
          "field": "out"
        }
      ],
      "returnImages": {
        "field": "out"
      },
      "openAfter": "out",
      "successMessage": "Photo saved.",
      "helpArgs": [
        [
          "-h",
          "full"
        ]
      ]
    }
  ]
}
