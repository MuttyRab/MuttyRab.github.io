{
  "id": "7zip",
  "name": "Zip & Unzip",
  "tagline": "Open ZIP, RAR, 7z and TAR files, and make password-protected ZIP or 7z archives — on Mac, Windows and Linux, or by asking your AI.",
  "keywords": [
    "unzip",
    "open rar file",
    "extract 7z",
    "zip with password",
    "7-zip for mac",
    "7zip mcp",
    "rar extractor mac"
  ],
  "tier": "pro",
  "status": "live",
  "upstream": {
    "repo": "ip7z/7zip",
    "stars": 4000,
    "displayName": "7-Zip",
    "license": "LGPL-2.1 (+ unRAR restriction)",
    "homepage": "https://www.7-zip.org"
  },
  "binary": {
    "name": "7zz",
    "version": "26.06",
    "assets": {
      "linux-x64": {
